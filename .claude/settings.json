{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "biome check --write --linter-enabled=false $(jq -r '.tool_input.file_path') 2>/dev/null || true",
            "if": "Edit(src/**/*.ts)|Write(src/**/*.ts)"
          }
        ]
      }
    ]
  }
}
